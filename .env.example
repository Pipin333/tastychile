# Base de datos PostgreSQL (Neon / Vercel Postgres) - Opcional para modo Mago de Oz local
DATABASE_URL="postgresql://usuario:contraseña@servidor.neon.tech/neondb?sslmode=require"
# En caso de variables inyectadas por Vercel:
# TASTY_DATABASE_URL="postgresql://..."
# TASTY_POSTGRES_URL="postgresql://..."

# Correo de destino para Notificaciones de Pedidos Mago de Oz y Leads B2B
CONTACT_EMAIL="comercial@selvaalta.cl"
SALES_EMAIL="comercial@selvaalta.cl"

# Servicio de Email Transaccional (Resend)
# Nota: Si se deja vacío, el sistema opera en modo simulación segura en consola.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Selva Alta <onboarding@resend.dev>"

# URL base pública del sitio
NEXT_PUBLIC_APP_URL="http://localhost:3000"
